# PayRight environment.
# Copy to ".env" and fill in. ".env" is gitignored.

# ── Vision read path (DEV SCAFFOLDING) ───────────────────────────────────────
# Groq API key — SERVER-SIDE ONLY. Used by the /api/scan endpoint (Vite dev
# plugin in dev, functions/api/scan.ts in production). Never exposed to the
# browser. This whole path is temporary dev tooling; production OCR will run
# on-device (PaddleOCR-VL), with no backend and no image leaving the phone.
GROQ_API_KEY=

# Optional: pin a specific Groq vision model id. If unset, the server selects a
# current vision-capable model from Groq's live /models list.
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Read engine selection (client) ───────────────────────────────────────────
# "vision" = Groq vision LLM (dev default). "paddle" = on-device PP-OCRv5.
VITE_OCR_ENGINE=vision
